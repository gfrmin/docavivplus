{
  // Cloudflare Workers config. Deploy by pushing to master —
  // .github/workflows/deploy.yml calls the shared recipe in gfrmin/site-kit.
  //
  // Migrated from Cloudflare Pages 2026-09-05. Pages stays supported and gets
  // bug fixes, but all new platform investment goes to Workers. The old Pages
  // project `docavivplus` is left in place as the rollback.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "docavivplus",
  "compatibility_date": "2026-09-05",

  "assets": {
    "directory": "./dist",

    // A multi-page static site with a real sitemap: an unmatched path is a
    // genuine 404 and must say so. Under Pages' default fallback (and under
    // "single-page-application", which the cutover used to preserve it) every
    // mistyped film URL returned 200 and the index page, so a crawler could
    // index the same content under unlimited URLs.
    //
    // Serves dist/404.html, which Astro builds from src/pages/404.astro. This
    // setting is inert without that file.
    "not_found_handling": "404-page",
  },

  "observability": {
    "enabled": true,
  },
}
